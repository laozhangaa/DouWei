<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_round_18_color_white"
    android:clipToOutline="true"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="地图服务"
            android:textColor="@color/black_80"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选择地图，配置你的专属凭证"
            android:textColor="@color/black_50"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rg_map_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_baidu"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_provider_option"
                android:buttonTint="@color/master_color"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="百度地图"
                android:textColor="@color/black_80"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_amap"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_provider_option"
                android:buttonTint="@color/master_color"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="高德地图"
                android:textColor="@color/black_80"
                android:textSize="14sp" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_amap_key"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="高德 Android Key"
            app:boxBackgroundColor="#F8FAFC"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/master_color"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/master_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_amap_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:fontFamily="sans"
                android:imeOptions="actionNext"
                android:inputType="textPassword|textNoSuggestions"
                android:singleLine="true"
                android:textColor="@color/black_80"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_baidu_ak"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="百度 Android AK"
            app:boxBackgroundColor="#F8FAFC"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/master_color"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/master_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_baidu_ak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:fontFamily="sans"
                android:imeOptions="actionDone"
                android:inputType="textPassword|textNoSuggestions"
                android:singleLine="true"
                android:textColor="@color/black_80"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_map_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/black_50"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_map_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/danger_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_map_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/shape_round_30_color_grey"
                android:minHeight="0dp"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="@color/black_50"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_map_save"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/shape_round_30_color_primary"
                android:minHeight="0dp"
                android:text="保存"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
