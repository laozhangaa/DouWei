<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/shape_round_18_color_white">
    <TextView android:id="@+id/tv_favorites_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的收藏" android:textColor="@color/home_text_primary" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="点按使用 · 长按管理" android:textColor="@color/home_text_secondary" android:textSize="12sp"/>
    <TextView android:id="@+id/tv_favorites_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="30dp" android:gravity="center" android:lineSpacingExtra="6dp" android:paddingHorizontal="8dp" android:text="正在读取收藏…" android:textColor="@color/home_text_secondary" android:textSize="14sp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_favorites" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:overScrollMode="never" android:visibility="gone"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_favorites_close" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp" android:background="@drawable/shape_round_30_color_grey" android:minHeight="0dp" android:text="关闭" android:textAllCaps="false" android:textColor="@color/black_50" android:textSize="14sp"/>
</LinearLayout>
