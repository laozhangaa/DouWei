<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="clickListener" type="OnClickListener" />
        <import type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:id="@+id/ll_navi_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/shape_round_18_color_white"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="路线规划"
                android:textColor="@color/black_80"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_add_waypoint"
                clickListener="@{clickListener}"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_route_action"
                android:drawableStart="@drawable/ic_route_add"
                android:drawablePadding="3dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="途经点"
                android:textColor="@color/master_color"
                android:textSize="12sp" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rg_travel_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_status"
            android:padding="4dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/travel_driving" style="@style/TravelModeOption" android:text="驾车" />
            <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/travel_cycling" style="@style/TravelModeOption" android:text="骑行" />
            <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/travel_walking" style="@style/TravelModeOption" android:text="步行" />
            <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/travel_running" style="@style/TravelModeOption" android:text="跑步" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_road_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="沿真实道路规划 · 按出行方式选择可通行路线"
            android:textColor="@color/home_text_secondary"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_navi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="按住右侧四点图标可调整顺序"
            android:textColor="#8995A4"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF1F5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/radio_multi_route"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:buttonTint="@color/master_color"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:text="多路线选择"
                android:textColor="#596777"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/iv_navi_setting"
                clickListener="@{clickListener}"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_route_speed"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="速度设置"
                android:textColor="@color/master_color"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView android:id="@+id/btn_route_options" clickListener="@{clickListener}"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp"
            android:gravity="center_vertical" android:background="@drawable/bg_route_action"
            android:text="路线与行驶 · 推荐路线 · 匀速" android:textSize="12sp" android:textColor="@color/master_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/btn_route_favorites" style="@style/FavoriteAction" clickListener="@{clickListener}" android:text="我的路线" />
            <TextView android:id="@+id/btn_save_route" style="@style/FavoriteAction" android:layout_marginStart="10dp" clickListener="@{clickListener}" android:text="收藏路线" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_start_navi"
            clickListener="@{clickListener}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_round_30_color_primary"
            android:minHeight="0dp"
            android:text="开始模拟"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</layout>
