<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/shape_round_18_color_white">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导航进度" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/home_text_primary" />
    <TextView android:id="@+id/tv_navigation_progress_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:lineSpacingExtra="6dp" android:textColor="@color/home_text_secondary" />
    <androidx.appcompat.widget.AppCompatSeekBar android:id="@+id/seek_navigation_progress" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:max="1000" android:contentDescription="沿路线调整模拟进度" android:progressTint="@color/master_color" android:thumbTint="@color/master_color" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="拖动后将跳到所选道路位置；暂停状态下调整不会自动开始。预计时间不包含实际路况变化。" android:textSize="12sp" android:textColor="@color/home_text_secondary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_navigation_progress_close" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minHeight="0dp" android:background="@drawable/shape_round_30_color_grey" android:text="关闭" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/home_text_secondary" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_navigation_restart" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="12dp" android:minHeight="0dp" android:background="@drawable/bg_route_action" android:text="回到起点" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/master_color" />
    </LinearLayout>
</LinearLayout>
