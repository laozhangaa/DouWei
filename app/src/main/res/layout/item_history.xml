<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="1dp"
    android:background="@drawable/shape_round_18_color_white"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="76dp"
    android:padding="14dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_history_type"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_home_icon"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/ic_map_locate"
        app:tint="@color/master_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <TextView
        android:id="@+id/tv_poi_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/home_text_primary"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/iv_history_type"
        app:layout_constraintEnd_toStartOf="@id/iv_history_arrow"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tv_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/home_text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/tv_poi_name"
        app:layout_constraintEnd_toEndOf="@id/tv_poi_name"
        app:layout_constraintTop_toBottomOf="@id/tv_poi_name"
        app:layout_constraintBottom_toBottomOf="parent" />
    <ImageView
        android:id="@+id/iv_history_arrow"
        android:layout_width="16dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_route_chevron"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
