<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/shape_round_18_color_white">
    <TextView android:id="@+id/tv_favorite_action_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/home_text_primary" android:textSize="17sp" android:textStyle="bold"/>
    <TextView android:id="@+id/btn_favorite_rename" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/bg_route_action" android:text="重命名" android:textColor="@color/master_color" android:textSize="14sp"/>
    <TextView android:id="@+id/btn_favorite_delete" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="?attr/selectableItemBackground" android:text="删除收藏" android:textColor="@color/danger_red" android:textSize="14sp"/>
    <TextView android:id="@+id/btn_favorite_action_cancel" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/shape_round_30_color_grey" android:text="取消" android:textColor="@color/black_50" android:textSize="14sp"/>
</LinearLayout>
