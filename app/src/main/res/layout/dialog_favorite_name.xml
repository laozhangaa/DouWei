<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false"
    android:background="@drawable/shape_round_18_color_white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/tv_favorite_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="收藏位置" android:textColor="@color/home_text_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_favorite_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/home_text_secondary" android:textSize="13sp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_favorite_name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="收藏名称"
            app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp"
            app:boxBackgroundColor="#F8FAFC" app:boxStrokeColor="@color/master_color" app:hintTextColor="@color/master_color" app:counterEnabled="true" app:counterMaxLength="40">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_favorite_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="54dp" android:inputType="textCapSentences" android:imeOptions="actionDone" android:maxLength="40" android:singleLine="true" android:textColor="@color/home_text_primary" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_favorite_cancel" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/shape_round_30_color_grey" android:minHeight="0dp" android:text="取消" android:textAllCaps="false" android:textColor="@color/black_50" android:textSize="14sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_favorite_save" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@drawable/shape_round_30_color_primary" android:minHeight="0dp" android:text="保存" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
