<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="title"
            type="String" />

        <variable
            name="clickListener"
            type="OnClickListener" />

        <variable
            name="isNavi"
            type="Boolean" />

        <import type="android.view.View" />

        <import type="android.view.View.OnClickListener" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_background"
        android:clipChildren="false"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbar"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                app:collapsedTitleTextAppearance="@style/HomeCollapsedTitle"
                app:collapsedTitleTextColor="@color/white"
                app:expandedTitleTextAppearance="@style/HomeExpandedTitle"
                app:expandedTitleMarginBottom="58dp"
                app:expandedTitleMarginStart="25dp"
                app:expandedTitleTextColor="@color/white"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:title="@{title,default=模拟定位}">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/master_color"
                    android:scaleType="centerCrop"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.9" />

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_change"
                        clickListener="@{clickListener}"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left"
                        android:contentDescription="切换模式"
                        android:padding="12dp"
                        android:src="@drawable/ic_top_switch" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_expand"
                        clickListener="@{clickListener}"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="right"
                        android:contentDescription="设置"
                        android:padding="12dp"
                        android:src="@drawable/ic_top_settings" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_navi_add"
                        clickListener="@{clickListener}"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="right"
                        android:paddingHorizontal="10dp"
                        android:src="@drawable/ic_add"
                        android:visibility="gone" />

                </androidx.appcompat.widget.Toolbar>


            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-50dp"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
